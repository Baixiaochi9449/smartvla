{
  "latex-workshop.latex.outDir": "%DIR%/output/pdf",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "tectonic",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.tools": [
    {
      "name": "tectonic",
      "command": "/opt/homebrew/bin/tectonic",
      "args": [
        "--synctex",
        "--keep-logs",
        "--keep-intermediates",
        "--outdir=%OUTDIR%",
        "%DOC_EXT%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "tectonic",
      "tools": ["tectonic"]
    }
  ]
}
